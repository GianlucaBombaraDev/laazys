{
    "name": "laazys-monorepo",
    "version": "0.1.0-alpha.1",
    "private": true,
    "description": "Monorepo for Laazys, a Vue.js documentation generator driven by JSDoc comments",
    "packageManager": "pnpm@12.8.1",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build:packages": "pnpm -r --if-present run build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GianlucaBombaraDev/laazys.git"
    },
    "author": "Gianluca Bombara (https://github.com/GianlucaBombaraDev)",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.1",
        "@vitest/coverage-v8": "^5.0.3",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^5.0.3",
        "vue-eslint-parser": "^10.4.1"
    }
}
