{
  "name": "@gianlucabombaradev/laazys",
  "version": "0.1.0",
  "description": "Generate browsable documentation for Vue.js components and composables from their JSDoc comments",
  "keywords": [
    "vue",
    "vuejs",
    "documentation",
    "jsdoc",
    "docs-generator",
    "cli"
  ],
  "homepage": "https://github.com/GianlucaBombaraDev/laazys#readme",
  "bugs": {
    "url": "https://github.com/GianlucaBombaraDev/laazys/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GianlucaBombaraDev/laazys.git",
    "directory": "packages/laazys"
  },
  "license": "MIT",
  "author": "Gianluca Bombara (https://github.com/GianlucaBombaraDev)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "laazys": "./dist/bin/laazys.js"
  },
  "files": [
    "dist",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "tsc:fix": "node ./scripts/tsc-fix",
    "build": "tsc && pnpm run tsc:fix",
    "start:laazys": "node ./dist/bin/laazys.js"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "comment-parser": "^1.4.9",
    "express": "^5.2.1",
    "figlet": "^1.12.0",
    "open": "^11.0.4",
    "prettier": "^3.9.9",
    "vue-docgen-api": "^4.79.2",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@types/yargs": "^17.0.35",
    "supertest": "^7.3.0"
  }
}
