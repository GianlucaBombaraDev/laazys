{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(/packages/laazys/app/**)",
            "Read(/packages/*/dist/**)",
            "Read(/coverage/**)",
            "Edit(/packages/laazys/app/**)",
            "Edit(/packages/*/dist/**)",
            "Edit(/pnpm-lock.yaml)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/build-state.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/format.sh"
                    }
                ]
            }
        ]
    }
}
